# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ─── Gemini LLM ───────────────────────────────────────────────────────────────
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_MODEL=gemini-2.0-flash-lite

# ─── Whisper STT ──────────────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=Systran/faster-distil-whisper-medium.en
WHISPER_DEVICE=cpu

# ─── ElevenLabs TTS (key + voice_id rotate together) ─────────────────────────
ELEVENLABS_API_KEYS1=
ELEVENLABS_VOICE_ID1=
ELEVENLABS_API_KEYS2=
ELEVENLABS_VOICE_ID2=
ELEVENLABS_API_KEYS3=
ELEVENLABS_VOICE_ID3=
ELEVENLABS_API_KEYS4=
ELEVENLABS_VOICE_ID4=
ELEVENLABS_API_KEYS5=
ELEVENLABS_VOICE_ID5=
ELEVENLABS_API_KEYS6=
ELEVENLABS_VOICE_ID6=
ELEVENLABS_API_KEYS7=
ELEVENLABS_VOICE_ID7=
ELEVENLABS_API_KEYS8=
ELEVENLABS_VOICE_ID8=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ─── Pinecone RAG ─────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=voice-agent
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ─── HuggingFace Embeddings ───────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_TOP_K=3

# ─── MongoDB Session Memory ───────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB_NAME=ai_voice_agent
SESSION_EXPIRY_HOURS=2
